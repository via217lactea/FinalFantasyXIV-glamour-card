# Sheet URLs carry a build stamp from the manifest, so a rebuild changes the URL
# and these can be cached hard. The manifest itself must not be, or nobody would
# ever learn the stamp changed.
/sprites/*
  Cache-Control: public, max-age=31536000, immutable

/data/sprites.json
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  Cache-Control: public, max-age=3600
